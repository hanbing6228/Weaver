{
  "version": 2,
  "framework": null,
  "installCommand": "cd client && npm install",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/((?!api/|assets/|_vercel).*)", "destination": "/index.html" }
  ]
}
